# Config — never commit. Enforced by .github/workflows/secrets.yml
.env
.gcp/
*key.json
*credentials*.json
service-account*.json

# Local docs preview (tools/preview.sh)
.preview/

# Demo scratch. Note the leading **: a pattern with a mid-string slash is
# anchored to this file's directory, so plain `data/generated/` would never
# match demos/<slug>/data/generated/. All of this is regenerated by `gxr up`.
**/data/generated/
**/.verified_rows
*.log

# Python virtualenv for the Spanner client used by the loader and the bridge.
.venv/
venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
