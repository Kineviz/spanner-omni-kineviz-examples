# Copy to .env and adjust if you need to. .env is gitignored — never commit it.
#
# `./gxr up paysim-schemaless` copies this file for you if .env is missing, so
# in practice you never have to run the copy by hand. Nothing here is an account
# you have to own: Spanner Omni runs on this machine, so the defaults work as
# they stand.

# --- the deployment ---------------------------------------------------------
# Managed by `./gxr omni up`. Change these only if the defaults collide with
# something already running.

OMNI_CONTAINER=spanneromni
OMNI_VOLUME=spanner

# Pinned, never `latest`. Spanner Omni is preview software: the tag moves, the
# CLI and the schema move with it, and an unpinned demo breaks with nothing in
# git to explain why. Bump it deliberately and re-verify.
OMNI_VERSION=2026.r1-beta.2

OMNI_HOST=localhost
OMNI_PORT=15000
OMNI_CONSOLE_PORT=15026

# --- what this demo creates -------------------------------------------------
# The database. Teardown drops exactly this and nothing else — never the
# container, never the volume, both of which may hold other people's databases.
OMNI_DATABASE=kineviz-paysim-demo

# Property graph name, used in every query and in the Kineviz connect dialog.
OMNI_GRAPH=PaysimGraph

# --- synthetic data volume --------------------------------------------------
# Seeded, so the same numbers always produce the same graph — including the
# rings the queries find. Roughly 13.7k nodes and 25k edges at these settings.
PAYSIM_CLIENTS=400
PAYSIM_TRANSACTIONS=12000
PAYSIM_DAYS=30
PAYSIM_SEED=20260825

# --- the database proxy -----------------------------------------------------
# Used by `./gxr connect up`, which installs and runs graphxr-database-proxy
# and registers this database with it. Loopback only, on purpose: the proxy
# fronts a deployment with no TLS and no authentication.
PROXY_PORT=9080
PROXY_PROJECT=paysim-schemaless

# --- the live stream --------------------------------------------------------
# Used by `./gxr stream up`, which replays the transactions through Kafka into
# the same database instead of loading them in one shot. Only the transactions
# move: actors and identifiers stay exactly as `up` loaded them.
#
# Ports and project name are deliberately not the ones in
# Kineviz/pg-kineviz-examples (9092/8082, project `paysim-stream`), so both
# repos' streaming stacks can run on one laptop without a fight.
STREAM_PROJECT=paysim-schemaless-stream
KAFKA_PORT=9094
KAFKA_UI_PORT=8084
KAFKA_TOPIC=paysim.transactions
KAFKA_PARTITIONS=3
KAFKA_GROUP=paysim-schemaless-sink

# Replay pacing. One simulated hour takes STREAM_HOUR_SECONDS of wall clock. The
# dataset spans ~720 simulated hours, so 0.167 replays all 30 days in about two
# minutes — quiet stretches still stay quiet and fraud still lands in bursts,
# just closer together. Raise it to stretch the demo out (2.5 gives the old
# half hour). Set STREAM_RATE to a number (tx/second) for flat pacing instead,
# or STREAM_HOUR_SECONDS=0 to replay as fast as the broker accepts.
STREAM_HOUR_SECONDS=0.167
STREAM_RATE=

# The Kafka admin console on ${KAFKA_UI_PORT}. `off` skips the container.
STREAM_UI=on

# --- the dashboard ----------------------------------------------------------
# `./scripts/install-dashboard.sh` finds Kineviz on its own: it reads the port
# Kineviz Desktop persisted to <userData>/desktop-settings.json, then this
# override, then Desktop's default 31380, then the ports a dev server binds.
# Set it only if you launched Desktop with a port it did not persist.
KINEVIZ_DESKTOP_PORT=
