# Copy to .env and adjust if you need to. .env is gitignored — never commit it.
#
# Unlike the cloud repos in this family, none of this is an account you have to
# own. Spanner Omni runs on this machine, so the defaults below work as they
# stand — `cp .env.example .env` and you are done.

# --- the deployment ---------------------------------------------------------
# Managed by `./gxr omni up`. Change these only if the defaults collide with
# something already running.

OMNI_CONTAINER=spanneromni
OMNI_VOLUME=spanner

# Pinned, never `latest`. Spanner Omni is preview software: the tag moves, the
# CLI and the schema move with it, and an unpinned demo breaks with nothing in
# git to explain why. Bump it deliberately and re-verify.
OMNI_VERSION=2026.r1-beta.2

OMNI_HOST=localhost
OMNI_PORT=15000
OMNI_CONSOLE_PORT=15026

# --- what this demo creates -------------------------------------------------
# The database. Teardown drops exactly this and nothing else — never the
# container, never the volume, both of which may hold other people's databases.
OMNI_DATABASE=kineviz-fraud-demo

# Property graph name, used in every query and in the Kineviz connect dialog.
OMNI_GRAPH=FraudGraph

# --- synthetic data volume --------------------------------------------------
# Seeded, so the same numbers always produce the same graph — including the
# rings the queries find.
FRAUD_CLIENTS=300
FRAUD_TRANSACTIONS=2000
FRAUD_DAYS=30
FRAUD_SEED=20260819
